# Combined environment example (non-secret placeholders)
# Copy relevant blocks into:
# - wearnest/.env
# - backend/.env

# --------------------
# Frontend (client)
# --------------------
VITE_API_BASE_URL=http://localhost:5000
VITE_CLOUDINARY_CLOUD_NAME=

# --------------------
# Backend (server)
# --------------------
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/wearnest?retryWrites=true&w=majority
JWT_SECRET=<replace-me>
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

CLOUDINARY_CLOUD_NAME=<replace-me>
CLOUDINARY_API_KEY=<replace-me>
CLOUDINARY_API_SECRET=<replace-me>

EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

STRIPE_SECRET_KEY=
SSL_COMMERZ_STORE_ID=
SSL_COMMERZ_STORE_PASSWORD=

